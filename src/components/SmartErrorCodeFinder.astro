---
---

<div class="w-full" data-smart-finder>
  <div class="mx-auto w-full max-w-[980px] rounded-3xl border border-brand-border/50 bg-brand-surface/80 p-4 sm:p-6 shadow-[0_8px_30px_rgb(0,0,0,0.2)] backdrop-blur-sm relative overflow-hidden group">
    <canvas data-finder-bg class="absolute inset-0 z-0 pointer-events-none opacity-70"></canvas>
    <div class="absolute inset-0 z-0 bg-gradient-to-r from-brand-primary/10 via-brand-accent/5 to-transparent opacity-0 transition-opacity duration-500 rounded-3xl pointer-events-none group-hover:opacity-100"></div>

    <div class="relative z-10 space-y-4">
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <label for="finder-industry" class="block text-xs font-semibold tracking-wide text-slate-300 uppercase mb-2">Industry</label>
          <select id="finder-industry" class="w-full h-11 rounded-xl border border-brand-border/60 bg-brand-dark/40 px-3 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-primary/50">
            <option value="">Auto-detect</option>
          </select>
        </div>

        <div>
          <label for="finder-subcategory" class="block text-xs font-semibold tracking-wide text-slate-300 uppercase mb-2" data-subcategory-label>Subcategory</label>
          <select id="finder-subcategory" class="w-full h-11 rounded-xl border border-brand-border/60 bg-brand-dark/40 px-3 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-primary/50" disabled>
            <option value="">Auto</option>
          </select>
        </div>

        <div>
          <label for="finder-brand" class="block text-xs font-semibold tracking-wide text-slate-300 uppercase mb-2" data-brand-label>Brand / System</label>
          <select id="finder-brand" class="w-full h-11 rounded-xl border border-brand-border/60 bg-brand-dark/40 px-3 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-primary/50 hidden" disabled>
            <option value="">Optional</option>
          </select>
        </div>

        <div data-model-col hidden>
          <label for="finder-model" class="block text-xs font-semibold tracking-wide text-slate-300 uppercase mb-2">Series / Model</label>
          <select id="finder-model" class="w-full h-11 rounded-xl border border-brand-border/60 bg-brand-dark/40 px-3 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-primary/50" disabled>
            <option value="">Optional</option>
          </select>
        </div>
      </div>

      <div class="relative">
        <label class="sr-only" for="q">Search Error Codes</label>
        <div class="flex flex-col sm:flex-row sm:items-center gap-3">
          <div class="relative flex-1">
            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4">
              <svg class="h-5 w-5 text-slate-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <input id="q" name="q" type="search" placeholder="Search code (e.g. 00, CP2000, 0x800…)" aria-label="Search error codes" class="block w-full h-12 sm:h-14 rounded-2xl border border-brand-border/60 bg-brand-dark/40 py-3 pl-11 pr-4 text-base text-slate-100 placeholder-slate-500/80 shadow-inner focus:ring-2 focus:ring-brand-primary/60 focus:bg-brand-dark transition-all duration-300 tracking-wide" autocomplete="off" />
          </div>

          <button type="button" data-finder-submit class="inline-flex items-center justify-center h-12 sm:h-14 px-7 rounded-2xl bg-brand-primary text-brand-dark font-bold text-sm tracking-wide hover:bg-brand-accent hover:shadow-[0_0_15px_rgba(16,208,97,0.35)] transition-all duration-300 transform active:scale-95 w-full sm:w-auto">Search</button>
        </div>

        <div id="finder-results" class="absolute left-0 right-0 top-full mt-4 hidden rounded-2xl border border-brand-border bg-brand-dark/95 shadow-[0_20px_40px_rgba(0,0,0,0.6)] max-h-96 overflow-y-auto custom-scrollbar z-50 transform origin-top transition-all duration-200 translate-y-1 scale-95 opacity-0" role="region" aria-label="Search results">
          <ul class="divide-y divide-brand-border/50"></ul>
        </div>
      </div>

      <div id="finder-status" class="text-xs text-slate-500 font-mono px-1 opacity-0 transition-opacity duration-200" aria-live="polite"></div>

      <div id="finder-preview" class="hidden rounded-2xl border border-brand-border/60 bg-brand-dark/40 px-4 py-4">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-3">
          <div class="min-w-0">
            <div class="flex items-center gap-2 mb-2">
              <span id="preview-code" class="font-mono text-xs font-bold text-brand-primary bg-brand-primary/10 px-2 py-1 rounded border border-brand-primary/20">—</span>
              <span id="preview-industry" class="text-[10px] uppercase tracking-wider text-slate-500 border border-brand-border/60 px-2 py-1 rounded-full">—</span>
            </div>
            <div id="preview-title" class="text-sm font-semibold text-slate-100 truncate">—</div>
            <div id="preview-summary" class="mt-1 text-sm text-slate-400">—</div>
            <div id="preview-hook" class="mt-2 text-xs text-slate-500">Open the full page for step-by-step fixes and related codes.</div>
          </div>
          <div class="shrink-0 flex flex-col sm:flex-row gap-2">
            <a id="preview-cta" href="#" class="inline-flex items-center justify-center h-10 px-4 rounded-xl bg-brand-primary text-brand-dark font-bold text-xs tracking-wide hover:bg-brand-accent transition-colors">View full fix</a>
            <a id="preview-fallback" href="#" class="inline-flex items-center justify-center h-10 px-4 rounded-xl border border-brand-border/70 bg-brand-surface/40 text-slate-200 font-semibold text-xs tracking-wide hover:bg-brand-dark/40 transition-colors">Browse best directory</a>
          </div>
        </div>

        <div class="mt-4" id="preview-related-wrap" hidden>
          <div class="text-[10px] uppercase tracking-wider text-slate-500 mb-2">Related error codes</div>
          <div id="preview-related" class="flex flex-wrap gap-2"></div>
        </div>
      </div>

      <noscript>
        <div class="rounded-lg bg-yellow-900/20 p-4 text-sm text-yellow-200 border border-yellow-900/50">Search results require JavaScript. Browsing by industry remains fully crawlable.</div>
      </noscript>
    </div>
  </div>
</div>

<script type="module">
  const normalizeText = (v) => String(v ?? '').trim().toLowerCase();
  const normalizeCode = (v) => String(v ?? '').trim().toUpperCase().replaceAll(' ', '').replaceAll('_', '-');
  const normalizeCodeLoose = (v) => normalizeCode(v).replaceAll('-', '');
  const stripLeadingZeros = (v) => String(v).replace(/^0+/, '');

  const buildQueryVariants = (queryRaw) => {
    const base = normalizeCode(queryRaw);
    const baseLoose = normalizeCodeLoose(queryRaw);
    const variants = new Set();
    const variantsLoose = new Set();

    const add = (q) => {
      const n = normalizeCode(q);
      if (!n) return;
      variants.add(n);
      variantsLoose.add(normalizeCodeLoose(n));
    };

    add(base);

    if (/^X[0-9A-F]/.test(base)) add(`0${base}`);
    if (/^0X/.test(base)) add(base.slice(1));
    if (/^X0[0-9A-F]/.test(base)) add(`0X${base.slice(2)}`);
    if (/^0X0[0-9A-F]/.test(base)) add(`0X${base.slice(3)}`);

    if (/^(0X)[0-9A-F]+$/.test(base)) {
      const rest = stripLeadingZeros(base.slice(2));
      if (rest) add(`0X${rest}`);
    }

    if (baseLoose.length >= 2) {
      if (/^X[0-9A-F]/.test(baseLoose)) add(`0${baseLoose}`);
      if (/^0X/.test(baseLoose)) add(baseLoose.slice(1));
      if (/^X0[0-9A-F]/.test(baseLoose)) add(`0X${baseLoose.slice(2)}`);
      if (/^0X0[0-9A-F]/.test(baseLoose)) add(`0X${baseLoose.slice(3)}`);
    }

    return {
      raw: String(queryRaw ?? ''),
      variants: Array.from(variants),
      variantsLoose: Array.from(variantsLoose),
      text: normalizeText(queryRaw),
    };
  };
  const titleFromKey = (key) =>
    String(key || '')
      .split('-')
      .filter(Boolean)
      .map((w) => (w.length ? w[0].toUpperCase() + w.slice(1) : w))
      .join(' ');

  const stableSort = (arr, cmp) =>
    arr
      .map((v, idx) => ({ v, idx }))
      .sort((a, b) => {
        const d = cmp(a.v, b.v);
        return d !== 0 ? d : a.idx - b.idx;
      })
      .map((x) => x.v);

  const augmentIndexItem = (it) => {
    const url = String(it.url || '');
    const parts = url.split('/').filter(Boolean);
    let topIndustryKey = it.industry;
    let subcategoryKey;

    if (url.startsWith('/insurance/healthcare/')) {
      topIndustryKey = 'healthcare';
    } else if (url.startsWith('/insurance/')) {
      topIndustryKey = it.industry === 'healthcare' ? 'healthcare' : 'insurance';
      if (topIndustryKey === 'insurance') {
        const idx = parts.indexOf('insurance');
        const errIdx = parts.indexOf('error-codes');
        if (idx !== -1 && errIdx !== -1 && errIdx === idx + 2) subcategoryKey = parts[idx + 1];
      }
    } else if (url.startsWith('/systems/')) {
      topIndustryKey = 'systems';
      const idx = parts.indexOf('systems');
      const errIdx = parts.indexOf('error-codes');
      if (idx !== -1 && errIdx !== -1 && errIdx === idx + 2) subcategoryKey = parts[idx + 1];
    } else if (url.startsWith('/appliances/')) {
      topIndustryKey = 'appliances';
    } else {
      topIndustryKey = it.industry;
    }

    return {
      ...it,
      topIndustryKey,
      subcategoryKey,
      normCode: normalizeCode(it.code),
      normCodeLoose: normalizeCodeLoose(it.code),
      normLabel: normalizeText(it.shortLabel),
    };
  };

  const buildTaxonomy = (items) => {
    const industries = new Set();
    const insuranceSubs = new Set();
    const systemsSubs = new Set();
    const applianceTypes = new Set();
    const brandsByType = new Map();
    const modelsByTypeBrand = new Map();

    for (const it of items) {
      industries.add(it.topIndustryKey);
      if (it.topIndustryKey === 'insurance' && it.subcategoryKey) insuranceSubs.add(it.subcategoryKey);
      if (it.topIndustryKey === 'systems' && it.subcategoryKey) systemsSubs.add(it.subcategoryKey);
      if (it.topIndustryKey === 'appliances') {
        const t = it.applianceType || '';
        const b = it.brand || '';
        const m = it.seriesOrModel || '';
        if (t) applianceTypes.add(t);
        if (t && b) {
          if (!brandsByType.has(t)) brandsByType.set(t, new Set());
          brandsByType.get(t).add(b);
        }
        if (t && b && m) {
          const k = `${t}::${b}`;
          if (!modelsByTypeBrand.has(k)) modelsByTypeBrand.set(k, new Set());
          modelsByTypeBrand.get(k).add(m);
        }
      }
    }

    const industryLabel = {
      insurance: 'Insurance',
      healthcare: 'Healthcare',
      'irs-tax': 'IRS / Tax',
      banking: 'Banking',
      gaming: 'Gaming',
      appliances: 'Appliances',
      systems: 'Systems & Devices',
    };

    const industriesArr = stableSort(Array.from(industries), (a, b) => {
      const keys = Object.keys(industryLabel);
      const ai = keys.indexOf(a);
      const bi = keys.indexOf(b);
      if (ai !== -1 && bi !== -1) return ai - bi;
      if (ai !== -1) return -1;
      if (bi !== -1) return 1;
      return String(a).localeCompare(String(b));
    }).map((k) => ({ key: k, label: industryLabel[k] || titleFromKey(k) }));

    const insuranceSubcategories = stableSort(Array.from(insuranceSubs), (a, b) => String(a).localeCompare(String(b))).map((k) => ({
      key: k,
      label: titleFromKey(k),
    }));

    const systemsSubcategories = stableSort(Array.from(systemsSubs), (a, b) => String(a).localeCompare(String(b))).map((k) => ({
      key: k,
      label: titleFromKey(k),
    }));

    const types = stableSort(Array.from(applianceTypes), (a, b) => String(a).localeCompare(String(b))).map((k) => ({
      key: k,
      label: titleFromKey(k),
    }));

    const brandsByTypeObj = {};
    for (const [t, s] of brandsByType.entries()) {
      brandsByTypeObj[t] = stableSort(Array.from(s), (a, b) => String(a).localeCompare(String(b))).map((k) => ({
        key: k,
        label: titleFromKey(k),
      }));
    }

    const modelsByTypeBrandObj = {};
    for (const [k, s] of modelsByTypeBrand.entries()) {
      modelsByTypeBrandObj[k] = stableSort(Array.from(s), (a, b) => String(a).localeCompare(String(b))).map((m) => ({
        key: m,
        label: m,
      }));
    }

    return {
      industries: industriesArr,
      insuranceSubcategories,
      systemsSubcategories,
      appliances: {
        types,
        brandsByType: brandsByTypeObj,
        modelsByTypeBrand: modelsByTypeBrandObj,
      },
    };
  };

  const applySelectionFilter = (items, sel) => {
    let out = items;
    if (sel.industryKey) out = out.filter((it) => it.topIndustryKey === sel.industryKey);
    if (sel.industryKey === 'insurance' && sel.subcategoryKey) out = out.filter((it) => it.subcategoryKey === sel.subcategoryKey);
    if (sel.industryKey === 'systems' && sel.subcategoryKey) out = out.filter((it) => it.subcategoryKey === sel.subcategoryKey);
    if (sel.industryKey === 'appliances') {
      if (sel.applianceType) out = out.filter((it) => (it.applianceType || '') === sel.applianceType);
      if (sel.brand) out = out.filter((it) => (it.brand || '') === sel.brand);
      if (sel.seriesOrModel) out = out.filter((it) => (it.seriesOrModel || '') === sel.seriesOrModel);
    }
    return out;
  };

  const isSubsequence = (needle, hay) => {
    if (!needle) return false;
    let i = 0;
    for (let j = 0; j < hay.length && i < needle.length; j++) {
      if (hay[j] === needle[i]) i++;
    }
    return i === needle.length;
  };

  const scoreMatch = (it, qv, qvLoose, qt) => {
    const reasons = [];
    if (!qv.length) return { item: it, score: 0, reasons };

    let best = 0;
    for (let i = 0; i < qv.length; i++) {
      const q = qv[i];
      const qLoose = qvLoose[i] || normalizeCodeLoose(q);

      if (it.normCode === q) {
        best = Math.max(best, 1000);
        reasons.push('exact-code');
        continue;
      }
      if (qLoose.length >= 2 && it.normCodeLoose === qLoose) {
        best = Math.max(best, 900);
        reasons.push('exact-code-loose');
        continue;
      }
      if (q.length >= 2 && it.normCode.startsWith(q)) {
        best = Math.max(best, 650);
        reasons.push('code-prefix');
        continue;
      }
      if (qLoose.length >= 2 && it.normCodeLoose.startsWith(qLoose)) {
        best = Math.max(best, 620);
        reasons.push('code-prefix-loose');
        continue;
      }
      if (qLoose.length >= 3 && it.normCodeLoose.includes(qLoose)) {
        best = Math.max(best, 520);
        reasons.push('code-contains');
        continue;
      }
      if (qLoose.length >= 3 && isSubsequence(qLoose, it.normCodeLoose)) {
        best = Math.max(best, 360);
        reasons.push('code-fuzzy');
        continue;
      }
    }

    if (best === 0) {
      const hay = `${it.normCode} ${it.normLabel} ${normalizeText(it.topIndustryKey)} ${normalizeText(it.subcategoryKey || '')}`;
      const h = normalizeText(hay);
      if (qt.length >= 2 && h.includes(qt)) {
        best = 220;
        reasons.push('text-contains');
        if (it.normLabel.includes(qt)) best += 40;
      }
    }

    return { item: it, score: best, reasons };
  };

  const findMatches = (items, queryRaw, sel, limit = 12) => {
    const spec = buildQueryVariants(queryRaw);
    const filtered = applySelectionFilter(items, sel);
    const scored = filtered.map((it) => scoreMatch(it, spec.variants, spec.variantsLoose, spec.text)).filter((m) => m.score > 0);
    const sorted = stableSort(scored, (a, b) => b.score - a.score);
    return sorted.slice(0, limit);
  };

  const findExact = (items, queryRaw) => {
    const spec = buildQueryVariants(queryRaw);
    const qSet = new Set(spec.variants);
    const qLooseSet = new Set(spec.variantsLoose);
    return items.filter((it) => qSet.has(it.normCode) || qLooseSet.has(it.normCodeLoose));
  };

  const inferSelection = (items, queryRaw, current, hintMatch) => {
    const spec = buildQueryVariants(queryRaw);
    if (!spec.variants.length) return { next: current, confidence: 'none' };
    const exact = findExact(items, queryRaw);
    const seed = exact.length ? exact : hintMatch ? [hintMatch] : [];
    if (!seed.length) return { next: current, confidence: 'none' };

    const byIndustry = new Map();
    for (const it of seed) {
      const k = it.topIndustryKey;
      if (!byIndustry.has(k)) byIndustry.set(k, []);
      byIndustry.get(k).push(it);
    }
    const industries = Array.from(byIndustry.entries()).sort((a, b) => b[1].length - a[1].length);
    const top = industries[0];
    const next = { ...current };
    if (!next.industryKey) next.industryKey = top[0];

    if (next.industryKey === 'insurance' && !next.subcategoryKey) {
      const subs = new Set(seed.filter((it) => it.topIndustryKey === 'insurance').map((it) => it.subcategoryKey).filter(Boolean));
      if (subs.size === 1) next.subcategoryKey = Array.from(subs)[0];
    }
    if (next.industryKey === 'systems' && !next.subcategoryKey) {
      const subs = new Set(seed.filter((it) => it.topIndustryKey === 'systems').map((it) => it.subcategoryKey).filter(Boolean));
      if (subs.size === 1) next.subcategoryKey = Array.from(subs)[0];
    }
    if (next.industryKey === 'appliances') {
      const match = seed.find((it) => it.topIndustryKey === 'appliances');
      if (match) {
        if (!next.applianceType && match.applianceType) next.applianceType = match.applianceType;
        if (!next.brand && match.brand) next.brand = match.brand;
        if (!next.seriesOrModel && match.seriesOrModel) next.seriesOrModel = match.seriesOrModel;
      }
    }

    if (industries.length === 1 && exact.length === 1) return { next, confidence: 'high' };
    if (industries.length === 1) return { next, confidence: exact.length ? 'medium' : 'low' };
    return { next, confidence: 'low' };
  };

  const withQ = (url, q) => {
    if (!q) return url;
    const has = url.includes('?');
    const sep = has ? '&' : '?';
    return `${url}${sep}q=${encodeURIComponent(q)}`;
  };

  const getFallbackUrl = (sel, queryRaw) => {
    const q = normalizeCode(queryRaw);
    if (sel.industryKey === 'banking') return withQ('/banking/error-codes/', q);
    if (sel.industryKey === 'gaming') return withQ('/gaming/error-codes/', q);
    if (sel.industryKey === 'irs-tax') return withQ('/irs-tax/error-codes/', q);
    if (sel.industryKey === 'healthcare') return withQ('/insurance/healthcare/error-codes/', q);
    if (sel.industryKey === 'insurance') {
      if (sel.subcategoryKey) return withQ(`/insurance/${sel.subcategoryKey}/error-codes/`, q);
      return '/insurance/';
    }
    if (sel.industryKey === 'systems') {
      if (sel.subcategoryKey) return withQ(`/systems/${sel.subcategoryKey}/error-codes/`, q);
      return '/systems/';
    }
    if (sel.industryKey === 'appliances') {
      if (sel.applianceType && sel.brand && sel.seriesOrModel) return `/appliances/${sel.applianceType}/${sel.brand}/${sel.seriesOrModel}/`;
      if (sel.applianceType && sel.brand) return `/appliances/${sel.applianceType}/${sel.brand}/`;
      if (sel.applianceType) return `/appliances/${sel.applianceType}/`;
      return '/appliances/';
    }
    return '/';
  };

  const pickUnique = (arr, count) => {
    if (count <= 0) return [];
    const copy = arr.slice();
    for (let i = copy.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      const tmp = copy[i];
      copy[i] = copy[j];
      copy[j] = tmp;
    }
    const out = [];
    const seen = new Set();
    for (const v of copy) {
      if (seen.has(v)) continue;
      seen.add(v);
      out.push(v);
      if (out.length >= count) break;
    }
    return out;
  };

  const initFinderBackground = ({ root, canvas, codes }) => {
    const prefersReduced = window.matchMedia?.('(prefers-reduced-motion: reduce)')?.matches;
    if (prefersReduced) {
      canvas.style.display = 'none';
      return;
    }
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const desired = Math.min(Math.max(7, Math.floor(7 + Math.random() * 8)), 14);
    const pool = pickUnique(
      codes
        .map((c) => String(c || '').trim())
        .filter(Boolean)
        .filter((c) => c.length <= 18),
      desired
    );
    if (!pool.length) return;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let raf = 0;
    let running = true;
    let last = performance.now();

    const particles = pool.map((text) => {
      const size = 10 + Math.random() * 10;
      const speed = 18 + Math.random() * 38;
      const angle = Math.random() * Math.PI * 2;
      return {
        text,
        x: Math.random() * 1,
        y: Math.random() * 1,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed,
        size,
        alpha: 0.22 + Math.random() * 0.24,
      };
    });

    const resize = () => {
      const rect = root.getBoundingClientRect();
      width = Math.max(1, Math.floor(rect.width));
      height = Math.max(1, Math.floor(rect.height));
      dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      for (const p of particles) {
        if (p.x <= 1) p.x = Math.random() * width;
        if (p.y <= 1) p.y = Math.random() * height;
        if (p.x > width) p.x = width - 8;
        if (p.y > height) p.y = height - 8;
      }
    };

    const draw = (now) => {
      if (!running) return;
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;

      ctx.clearRect(0, 0, width, height);
      for (const p of particles) {
        p.x += p.vx * dt;
        p.y += p.vy * dt;

        const pad = 12;
        if (p.x < pad) {
          p.x = pad;
          p.vx = Math.abs(p.vx);
        }
        if (p.x > width - pad) {
          p.x = width - pad;
          p.vx = -Math.abs(p.vx);
        }
        if (p.y < pad) {
          p.y = pad;
          p.vy = Math.abs(p.vy);
        }
        if (p.y > height - pad) {
          p.y = height - pad;
          p.vy = -Math.abs(p.vy);
        }

        ctx.globalAlpha = p.alpha;
        ctx.font = `${p.size}px ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace`;
        ctx.fillStyle = '#10d061';
        ctx.fillText(p.text, p.x, p.y);
      }
      ctx.globalAlpha = 1;
      raf = requestAnimationFrame(draw);
    };

    const io = new IntersectionObserver(
      (entries) => {
        const entry = entries[0];
        if (!entry) return;
        const next = entry.isIntersecting;
        if (next === running) return;
        running = next;
        if (running) {
          last = performance.now();
          raf = requestAnimationFrame(draw);
        } else {
          cancelAnimationFrame(raf);
        }
      },
      { threshold: 0.05 }
    );

    const ro = new ResizeObserver(() => resize());
    resize();
    io.observe(root);
    ro.observe(root);
    raf = requestAnimationFrame(draw);

    const cleanup = () => {
      cancelAnimationFrame(raf);
      io.disconnect();
      ro.disconnect();
    };
    window.addEventListener('pagehide', cleanup, { once: true });
  };

  const initSmartFinder = async (rootEl) => {
    if (!rootEl) return;
    const industryEl = rootEl.querySelector('#finder-industry');
    const subcategoryEl = rootEl.querySelector('#finder-subcategory');
    const brandEl = rootEl.querySelector('#finder-brand');
    const modelEl = rootEl.querySelector('#finder-model');
    const modelCol = rootEl.querySelector('[data-model-col]');
    const subLabel = rootEl.querySelector('[data-subcategory-label]');
    const brandLabel = rootEl.querySelector('[data-brand-label]');
    const inputEl = rootEl.querySelector('#q');
    const submitEl = rootEl.querySelector('[data-finder-submit]');
    const statusEl = rootEl.querySelector('#finder-status');
    const resultsWrap = rootEl.querySelector('#finder-results');
    const resultsList = resultsWrap?.querySelector('ul');
    const previewWrap = rootEl.querySelector('#finder-preview');
    const previewCode = rootEl.querySelector('#preview-code');
    const previewIndustry = rootEl.querySelector('#preview-industry');
    const previewTitle = rootEl.querySelector('#preview-title');
    const previewSummary = rootEl.querySelector('#preview-summary');
    const previewCta = rootEl.querySelector('#preview-cta');
    const previewFallback = rootEl.querySelector('#preview-fallback');
    const previewRelatedWrap = rootEl.querySelector('#preview-related-wrap');
    const previewRelated = rootEl.querySelector('#preview-related');
    const bgCanvas = rootEl.querySelector('canvas[data-finder-bg]');

    if (!industryEl || !subcategoryEl || !brandEl || !modelEl || !modelCol || !subLabel || !brandLabel) return;
    if (!inputEl || !submitEl || !statusEl || !resultsWrap || !resultsList) return;
    if (!previewWrap || !previewCode || !previewIndustry || !previewTitle || !previewSummary || !previewCta || !previewFallback) return;
    if (!previewRelatedWrap || !previewRelated) return;

    const state = {
      highlightedIndex: -1,
      sel: { industryKey: '', subcategoryKey: '', applianceType: '', brand: '', seriesOrModel: '' },
    };

    let loading = null;
    let augmented = [];
    let taxonomy = null;

    const setStatus = (msg) => {
      statusEl.textContent = msg;
      if (msg) {
        statusEl.classList.remove('opacity-0');
        statusEl.classList.add('opacity-100');
      } else {
        statusEl.classList.add('opacity-0');
        statusEl.classList.remove('opacity-100');
      }
    };

    const setResultsOpen = (open) => {
      if (!open) {
        resultsWrap.classList.add('hidden');
        resultsWrap.classList.remove('translate-y-0', 'scale-100', 'opacity-100');
        resultsWrap.classList.add('translate-y-1', 'scale-95', 'opacity-0');
        return;
      }
      resultsWrap.classList.remove('hidden');
      requestAnimationFrame(() => {
        resultsWrap.classList.remove('translate-y-1', 'scale-95', 'opacity-0');
        resultsWrap.classList.add('translate-y-0', 'scale-100', 'opacity-100');
      });
    };

    const setSelectAutofill = (el, on) => {
      if (on) {
        el.classList.add('ring-2', 'ring-brand-primary/40');
      } else {
        el.classList.remove('ring-2', 'ring-brand-primary/40');
      }
    };

    const loadIndex = async () => {
      if (taxonomy && augmented.length) return { taxonomy, augmented };
      if (!loading) {
        loading = fetch('/search-index.json')
          .then((r) => r.json())
          .then((data) => {
            const items = Array.isArray(data?.items) ? data.items : [];
            augmented = items.map(augmentIndexItem);
            taxonomy = buildTaxonomy(augmented);
            return { taxonomy, augmented };
          })
          .catch(() => {
            augmented = [];
            taxonomy = buildTaxonomy([]);
            return { taxonomy, augmented };
          });
      }
      return loading;
    };

    const rebuildIndustryOptions = () => {
      if (!taxonomy) return;
      const val = industryEl.value;
      industryEl.innerHTML = '<option value="">Auto-detect</option>';
      for (const opt of taxonomy.industries) {
        const o = document.createElement('option');
        o.value = opt.key;
        o.textContent = opt.label;
        industryEl.appendChild(o);
      }
      industryEl.value = val;
    };

    const rebuildSubcategoryOptions = () => {
      if (!taxonomy) return;
      const industryKey = state.sel.industryKey;
      const val = subcategoryEl.value;
      subcategoryEl.innerHTML = '<option value="">Auto</option>';
      if (industryKey === 'insurance') {
        for (const opt of taxonomy.insuranceSubcategories) {
          const o = document.createElement('option');
          o.value = opt.key;
          o.textContent = opt.label;
          subcategoryEl.appendChild(o);
        }
        subcategoryEl.disabled = false;
        subLabel.textContent = 'Subcategory';
        subcategoryEl.value = val;
        return;
      }
      if (industryKey === 'systems') {
        for (const opt of taxonomy.systemsSubcategories) {
          const o = document.createElement('option');
          o.value = opt.key;
          o.textContent = opt.label;
          subcategoryEl.appendChild(o);
        }
        subcategoryEl.disabled = false;
        subLabel.textContent = 'Subcategory';
        subcategoryEl.value = val;
        return;
      }
      if (industryKey === 'appliances') {
        for (const opt of taxonomy.appliances.types) {
          const o = document.createElement('option');
          o.value = opt.key;
          o.textContent = opt.label;
          subcategoryEl.appendChild(o);
        }
        subcategoryEl.disabled = false;
        subLabel.textContent = 'Type';
        subcategoryEl.value = val;
        return;
      }
      subcategoryEl.disabled = true;
      subLabel.textContent = 'Subcategory';
      subcategoryEl.value = '';
    };

    const rebuildBrandOptions = () => {
      if (!taxonomy) return;
      const industryKey = state.sel.industryKey;
      const val = brandEl.value;
      brandEl.innerHTML = '<option value="">Optional</option>';
      if (industryKey === 'appliances') {
        const t = state.sel.applianceType;
        brandEl.classList.remove('hidden');
        brandEl.disabled = !t;
        brandLabel.textContent = 'Brand';
        const list = t ? taxonomy.appliances.brandsByType[t] || [] : [];
        for (const opt of list) {
          const o = document.createElement('option');
          o.value = opt.key;
          o.textContent = opt.label;
          brandEl.appendChild(o);
        }
        brandEl.value = val;
        return;
      }
      brandEl.classList.add('hidden');
      brandEl.disabled = true;
      brandLabel.textContent = 'Brand / System';
      brandEl.value = '';
    };

    const rebuildModelOptions = () => {
      if (!taxonomy) return;
      const industryKey = state.sel.industryKey;
      const val = modelEl.value;
      modelEl.innerHTML = '<option value="">Optional</option>';
      if (industryKey === 'appliances') {
        modelCol.removeAttribute('hidden');
        const t = state.sel.applianceType;
        const b = state.sel.brand;
        const key = t && b ? `${t}::${b}` : '';
        const list = key ? taxonomy.appliances.modelsByTypeBrand[key] || [] : [];
        modelEl.disabled = !(t && b);
        for (const opt of list) {
          const o = document.createElement('option');
          o.value = opt.key;
          o.textContent = opt.label;
          modelEl.appendChild(o);
        }
        modelEl.value = val;
        return;
      }
      modelCol.setAttribute('hidden', '');
      modelEl.disabled = true;
      modelEl.value = '';
    };

    const rebuildControls = () => {
      rebuildSubcategoryOptions();
      rebuildBrandOptions();
      rebuildModelOptions();
    };

    const syncSelectionFromControls = () => {
      state.sel.industryKey = industryEl.value || '';
      const sub = subcategoryEl.value || '';
      const brand = brandEl.value || '';
      const model = modelEl.value || '';

      if (state.sel.industryKey === 'insurance' || state.sel.industryKey === 'systems') {
        state.sel.subcategoryKey = sub;
        state.sel.applianceType = '';
        state.sel.brand = '';
        state.sel.seriesOrModel = '';
        return;
      }
      if (state.sel.industryKey === 'appliances') {
        state.sel.subcategoryKey = '';
        state.sel.applianceType = sub;
        state.sel.brand = brand;
        state.sel.seriesOrModel = model;
        return;
      }
      state.sel.subcategoryKey = '';
      state.sel.applianceType = '';
      state.sel.brand = '';
      state.sel.seriesOrModel = '';
    };

    const renderResults = (matches, fallbackUrl, mode) => {
      resultsList.innerHTML = '';

      const showBrowseRow = !!fallbackUrl;
      if (!matches.length && !showBrowseRow) {
        setResultsOpen(false);
        return;
      }

      setResultsOpen(true);
      for (let i = 0; i < matches.length; i++) {
        const it = matches[i].item;
        const li = document.createElement('li');
        li.className = 'px-5 py-4 hover:bg-brand-surface/50 transition-colors cursor-pointer group first:rounded-t-xl last:rounded-b-xl';
        li.dataset.idx = String(i);
        const a = document.createElement('a');
        a.href = it.url;
        a.className = 'block text-sm text-slate-300 group-hover:text-white';
        const ind = it.topIndustryKey === 'irs-tax' ? 'IRS / Tax' : it.topIndustryKey.replaceAll('-', ' ');
        a.innerHTML = `<div class="flex items-center justify-between mb-1"><span class="font-mono text-xs font-bold text-brand-primary bg-brand-primary/10 px-2 py-1 rounded border border-brand-primary/20">${it.code}</span><span class="text-xs text-slate-500 uppercase tracking-wider">${ind}</span></div><div class="text-slate-400 group-hover:text-slate-200 font-medium">${it.shortLabel}</div>`;
        li.appendChild(a);
        resultsList.appendChild(li);
      }

      if (showBrowseRow) {
        const li = document.createElement('li');
        li.className = 'px-5 py-4 bg-brand-surface/30 hover:bg-brand-surface/40 transition-colors';
        const a = document.createElement('a');
        a.href = fallbackUrl;
        a.className = 'flex items-center justify-between gap-3 text-sm text-slate-200';
        a.innerHTML = `<span class="font-semibold">Browse best directory</span><span class="text-xs text-slate-500 font-mono">${mode === 'type' ? 'No exact match yet' : 'Fallback'}</span>`;
        li.appendChild(a);
        resultsList.appendChild(li);
      }
    };

    const setPreview = (top, related, fallbackUrl) => {
      if (!top) {
        previewWrap.classList.add('hidden');
        return;
      }
      previewWrap.classList.remove('hidden');
      previewCode.textContent = top.item.code;
      previewIndustry.textContent = top.item.topIndustryKey === 'irs-tax' ? 'IRS / Tax' : top.item.topIndustryKey.replaceAll('-', ' ');
      previewTitle.textContent = top.item.shortLabel;
      previewSummary.textContent = top.item.shortLabel ? `Meaning: ${top.item.shortLabel}.` : 'Open the full page for details.';
      previewCta.href = top.item.url;
      previewFallback.href = fallbackUrl;
      previewRelated.innerHTML = '';
      const rel = (related || []).slice(0, 5);
      if (!rel.length) {
        previewRelatedWrap.setAttribute('hidden', '');
        return;
      }
      previewRelatedWrap.removeAttribute('hidden');
      for (const r of rel) {
        const a = document.createElement('a');
        a.href = r.item.url;
        a.className = 'inline-flex items-center gap-2 rounded-full border border-brand-border/60 bg-brand-surface/40 px-3 py-1 text-xs text-slate-200 hover:bg-brand-dark/40 transition-colors';
        a.innerHTML = `<span class="font-mono text-[11px] text-brand-primary">${r.item.code}</span><span class="text-slate-300">${r.item.shortLabel}</span>`;
        previewRelated.appendChild(a);
      }
    };

    const highlightRow = (idx) => {
      const rows = Array.from(resultsList.querySelectorAll('li'));
      for (const r of rows) r.classList.remove('bg-brand-surface/50');
      const row = rows[idx];
      if (row) {
        row.classList.add('bg-brand-surface/50');
        state.highlightedIndex = idx;
        row.scrollIntoView({ block: 'nearest' });
      }
    };

    const openHighlighted = () => {
      const rows = Array.from(resultsList.querySelectorAll('li'));
      const row = rows[state.highlightedIndex];
      const a = row?.querySelector('a');
      if (a && a.href) {
        window.location.href = a.href;
        return true;
      }
      return false;
    };

    const runSearch = async (mode) => {
      const qRaw = inputEl.value || '';
      const spec = buildQueryVariants(qRaw);
      if (!spec.variants.length) {
        setStatus('');
        renderResults([], '', mode);
        setPreview(null, [], '#');
        return;
      }

      setStatus('Searching…');
      await loadIndex();

      syncSelectionFromControls();

      const exactAll = findExact(augmented, qRaw);
      let exactPick = null;
      if (exactAll.length === 1) exactPick = exactAll[0];
      if (!exactPick && exactAll.length > 1 && state.sel.industryKey) {
        exactPick = exactAll.find((it) => it.topIndustryKey === state.sel.industryKey) || null;
      }

      const globalTopForInference = exactPick ? exactPick : findMatches(augmented, qRaw, { industryKey: '', subcategoryKey: '', applianceType: '', brand: '', seriesOrModel: '' }, 1)[0]?.item;
      const inferred = inferSelection(augmented, qRaw, { ...state.sel }, globalTopForInference);
      const nextSel = inferred.next;

      const shouldAutofillIndustry = !state.sel.industryKey && !!nextSel.industryKey;
      const shouldAutofillSub = !state.sel.subcategoryKey && !!nextSel.subcategoryKey;
      const shouldAutofillType = state.sel.industryKey === 'appliances' && !state.sel.applianceType && !!nextSel.applianceType;

      if (shouldAutofillIndustry) {
        industryEl.value = nextSel.industryKey || '';
        state.sel.industryKey = industryEl.value;
      }
      if (!state.sel.subcategoryKey && nextSel.subcategoryKey) state.sel.subcategoryKey = nextSel.subcategoryKey;
      if (state.sel.industryKey === 'appliances') {
        if (!state.sel.applianceType && nextSel.applianceType) state.sel.applianceType = nextSel.applianceType;
        if (!state.sel.brand && nextSel.brand) state.sel.brand = nextSel.brand;
        if (!state.sel.seriesOrModel && nextSel.seriesOrModel) state.sel.seriesOrModel = nextSel.seriesOrModel;
      }

      rebuildControls();
      if (state.sel.industryKey === 'insurance' || state.sel.industryKey === 'systems') subcategoryEl.value = state.sel.subcategoryKey || '';
      if (state.sel.industryKey === 'appliances') {
        subcategoryEl.value = state.sel.applianceType || '';
        brandEl.value = state.sel.brand || '';
        modelEl.value = state.sel.seriesOrModel || '';
      }

      setSelectAutofill(industryEl, shouldAutofillIndustry);
      setSelectAutofill(subcategoryEl, shouldAutofillSub || shouldAutofillType);

      const matchesStrict = findMatches(augmented, qRaw, state.sel, 12);
      let matches = matchesStrict;
      let usedFallback = false;

      if (!matches.length && state.sel.industryKey) {
        const broader = { ...state.sel, subcategoryKey: '', brand: '', seriesOrModel: '', applianceType: state.sel.applianceType };
        matches = findMatches(augmented, qRaw, broader, 12);
        usedFallback = matches.length > 0;
      }
      if (!matches.length) {
        matches = findMatches(augmented, qRaw, { industryKey: '', subcategoryKey: '', applianceType: '', brand: '', seriesOrModel: '' }, 12);
        usedFallback = usedFallback || matches.length > 0;
      }

      const fallbackUrl = getFallbackUrl(state.sel, qRaw);
      if (matches.length) {
        setStatus(`${matches.length} suggestion(s)${usedFallback ? ' (closest matches)' : ''}`);
      } else {
        setStatus('No direct matches — browse a related directory');
      }
      renderResults(matches, fallbackUrl, mode);
      state.highlightedIndex = -1;

      const top = matches[0] || null;
      const related = matches.slice(1, 6);

      const isExact = !!exactPick || (!!top && top.score >= 900);
      const exactUrl = exactPick ? exactPick.url : top?.item?.url;

      if (mode === 'submit' && isExact && exactUrl) {
        window.location.href = exactUrl;
        return;
      }

      if (mode === 'submit' && !matches.length) {
        window.location.href = fallbackUrl;
        return;
      }

      if (mode === 'type') {
        if (top && top.score >= 520) setPreview(top, related, fallbackUrl);
        else setPreview(null, [], fallbackUrl);
        return;
      }

      setPreview(top, related, fallbackUrl);
    };

    await loadIndex();
    rebuildIndustryOptions();
    rebuildControls();

    if (bgCanvas && !bgCanvas.dataset.started) {
      bgCanvas.dataset.started = '1';
      initFinderBackground({ root: bgCanvas.parentElement, canvas: bgCanvas, codes: augmented.map((it) => it.code) });
    }

    const initialQuery = new URLSearchParams(window.location.search).get('q');
    if (initialQuery) {
      inputEl.value = initialQuery;
      runSearch('type');
    }

    industryEl.addEventListener('change', () => {
      syncSelectionFromControls();
      rebuildControls();
      runSearch('type');
    });
    subcategoryEl.addEventListener('change', () => {
      syncSelectionFromControls();
      rebuildControls();
      runSearch('type');
    });
    brandEl.addEventListener('change', () => {
      syncSelectionFromControls();
      rebuildControls();
      runSearch('type');
    });
    modelEl.addEventListener('change', () => {
      syncSelectionFromControls();
      rebuildControls();
      runSearch('type');
    });

    inputEl.addEventListener('input', () => {
      window.clearTimeout(inputEl.__t);
      inputEl.__t = window.setTimeout(() => runSearch('type'), 200);
    });

    inputEl.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        if (resultsWrap.classList.contains('hidden')) return;
        e.preventDefault();
        highlightRow(Math.min(state.highlightedIndex + 1, (resultsList.children.length || 1) - 1));
        return;
      }
      if (e.key === 'ArrowUp') {
        if (resultsWrap.classList.contains('hidden')) return;
        e.preventDefault();
        highlightRow(Math.max(state.highlightedIndex - 1, 0));
        return;
      }
      if (e.key === 'Enter') {
        e.preventDefault();
        if (state.highlightedIndex >= 0 && openHighlighted()) return;
        runSearch('submit');
        return;
      }
      if (e.key === 'Escape') {
        setResultsOpen(false);
        return;
      }
    });

    submitEl.addEventListener('click', (e) => {
      e.preventDefault();
      runSearch('submit');
    });

    document.addEventListener('click', (e) => {
      if (!rootEl.contains(e.target)) setResultsOpen(false);
    });
  };

  initSmartFinder(document.querySelector('[data-smart-finder]'));
</script>
